<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="700.0" styleClass="root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tcpfiletranffering.UIcontrollers.ControllerReceiver">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="small-button" text="← Back" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
      <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="title" text="📥 Receive File">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" maxWidth="500.0" spacing="25.0" styleClass="card">
               <children>
                  <VBox spacing="10.0">
                     <children>
                        <Label styleClass="header-label" text="Save Location">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Button fx:id="buttonSaveLocation" mnemonicParsing="false" styleClass="choose-button" text="Choose Folder" />
                              <Label fx:id="selectedLocation" maxWidth="300.0" styleClass="info-label" text="No location selected" textFill="#666666" wrapText="true" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="10.0">
                     <children>
                        <Label styleClass="info-label" text="ℹ️ The file will be saved with its original name in the selected folder." textAlignment="CENTER" textFill="#667eea" wrapText="true">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Button fx:id="buttonStartConnection" mnemonicParsing="false" onAction="#startConnection" prefHeight="50.0" prefWidth="220.0" styleClass="secondary-button" text="Start Receiving">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
            <Label fx:id="receivedStatus" alignment="CENTER" prefWidth="600.0" styleClass="status-label" text="" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</VBox>
