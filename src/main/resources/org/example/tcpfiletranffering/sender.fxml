<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tcpfiletranffering.UIcontrollers.ControllerSender">
   <children>
      <Label layoutX="72.0" layoutY="117.0" text="Receiver's IP" />
      <TextField fx:id="receiverIP" layoutX="177.0" layoutY="113.0" />
      <Button fx:id="selectFileButton" layoutX="66.0" layoutY="187.0" mnemonicParsing="false" text="Choose File" />
      <Label fx:id="selectedFile" layoutX="192.0" layoutY="191.0" maxWidth="-Infinity" text="File" textAlignment="JUSTIFY" wrapText="true" />
      <Button fx:id="fileSendButton" layoutX="218.0" layoutY="256.0" mnemonicParsing="false" onAction="#send" prefHeight="53.0" prefWidth="163.0" text="Send" />
      <Label layoutX="72.0" layoutY="48.0" text="Sender">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#goBack" text="&lt;&lt;" />
      <Label fx:id="sendingStatus" alignment="CENTER" layoutY="340.0" prefHeight="18.0" prefWidth="600.0" text="status" />
   </children>
</AnchorPane>
